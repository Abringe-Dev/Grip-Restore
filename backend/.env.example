# Server
PORT=3001
NODE_ENV=development
APP_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5199
APP_URL=http://localhost:5173
# Turso (production). Create a libSQL database at https://turso.tech
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-database-token

# Local SQLite file. Defaults to backend/data/grip-restore.db
# DATABASE_PATH=./data/grip-restore.db

# Set to false for the public demo to skip email verification.
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# Apply schema migrations on startup. Defaults to true in development and false
# in production; run `npm run db:migrate` before deploying.
# AUTO_MIGRATE=0

# Required in production. Used as an HMAC pepper before password hashing.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_PEPPER=replace-with-a-long-random-secret

# Trust the first proxy hop (set to 1 when behind a reverse proxy / HTTPS terminator)
TRUST_PROXY=0

# Optional SMTP delivery. Without SMTP_HOST, verification/reset links are
# logged to the console and returned to the client in development only.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Grip Restore <no-reply@example.com>"
